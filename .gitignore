# ───────────────────────────────────────────
# OS / Editor
# ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.user

# ───────────────────────────────────────────
# Next.js
# ───────────────────────────────────────────
cvd-lens/.next/
cvd-lens/out/
cvd-lens/node_modules/
cvd-lens/.env
cvd-lens/.env.local
cvd-lens/.env*.local

# ───────────────────────────────────────────
# Python / ML
# ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# cvdlens_v2 test/smoke temporary output (regenerated by test_model.py)
cvdlens_v2/_tmp_test_artifacts/

# ───────────────────────────────────────────
# 대용량 모델 / 데이터
# ───────────────────────────────────────────
*.onnx
*.ckpt
*.pt
*.pth
*.npz
*.h5
*.safetensors

model-training/data/raw/
model-training/data/processed/
model-training/outputs/checkpoints/
model-training/outputs/logs/

# ONNX 결과물은 추적 (fp32/fp16 최종본)
!model-training/outputs/onnx/

# ───────────────────────────────────────────
# Docker
# ───────────────────────────────────────────
# cvd-lens/inference/model/ 은 배포용 모델 포함으로 추적

# inference model 예외
!cvd-lens/inference/model/
!cvd-lens/inference/model/*.onnx

# Phase 2: browser ONNX models (ort-web) — served statically on Vercel
!cvd-lens/public/models/
!cvd-lens/public/models/*.onnx

# ───────────────────────────────────────────
# 불필요한 압축/빌드 산출물
# ───────────────────────────────────────────
*.zip
model-training/outputs/
model-training/**/*.ipynb

# outputs/는 기본 무시하되 phase0/phase1 아카이브만 트래킹.
# 학습 산출물(.pt는 전역 *.pt로 이미 무시, val_step*.json과 history.json은
# Kaggle 매 run에서 재생성되므로 명시 무시).
outputs/*
!outputs/v2_phase0/
!outputs/v2_phase1/
outputs/v2_phase1/val_step*.json
outputs/v2_phase1/history.json
# render_witness.py + diagnose_si.py 산출물 — 재생성 가능
outputs/v2_phase1/witness/
outputs/v2_phase1/si_diagnostic_*.txt