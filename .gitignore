# ───────────────────────────────────────────
# OS / Editor
# ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.user

# ───────────────────────────────────────────
# Next.js
# ───────────────────────────────────────────
cvd-lens/.next/
cvd-lens/out/
cvd-lens/node_modules/
cvd-lens/.env
cvd-lens/.env.local
cvd-lens/.env*.local

# ───────────────────────────────────────────
# Python / ML
# ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# cvdlens_v2 test/smoke temporary output (regenerated by test_model.py)
cvdlens_v2/_tmp_test_artifacts/

# ───────────────────────────────────────────
# 대용량 모델 / 데이터
# ───────────────────────────────────────────
*.onnx
*.ckpt
*.pt
*.pth
*.npz
*.h5
*.safetensors

model-training/data/raw/
model-training/data/processed/
model-training/outputs/checkpoints/
model-training/outputs/logs/

# ONNX 결과물은 추적 (fp32/fp16 최종본)
!model-training/outputs/onnx/

# ───────────────────────────────────────────
# Docker
# ───────────────────────────────────────────
# cvd-lens/inference/model/ 은 배포용 모델 포함으로 추적

# inference model 예외
!cvd-lens/inference/model/
!cvd-lens/inference/model/*.onnx

# ───────────────────────────────────────────
# 불필요한 압축/빌드 산출물
# ───────────────────────────────────────────
*.zip
model-training/outputs/
model-training/**/*.ipynb

# outputs/는 기본 무시하되 phase0/phase1 아카이브만 트래킹.
# 학습 산출물(.pt는 전역 *.pt로 이미 무시, val_step*.json과 history.json은
# Kaggle 매 run에서 재생성되므로 명시 무시).
outputs/*
!outputs/v2_phase0/
# Phase 0 그림(예: exp1c_lambda_sweep.png)은 재생성 가능 — md/json만 트래킹.
outputs/v2_phase0/*.png
!outputs/v2_phase1/
outputs/v2_phase1/val_step*.json
outputs/v2_phase1/history.json
# render_witness.py + diagnose_si.py 산출물 — 재생성 가능
outputs/v2_phase1/witness/
outputs/v2_phase1/si_diagnostic_*.txt
# Phase 2: RUNBOOK + 수치(json)만 트래킹. onnx는 inference/model/에 이미 있음(중복 제외).
!outputs/v2_phase2/
outputs/v2_phase2/*.onnx
# Phase 2 데모/검증 그림은 재생성 가능(ui_*.png=render/demo 스크립트,
# infer_fix/=cvd-lens/inference/validate_infer.py) — RUNBOOK·parity json만 트래킹.
outputs/v2_phase2/*.png
outputs/v2_phase2/infer_fix/
# Phase 3: CRR/NP 평가 산출물(eval set/results, 리포트, 그림) 트래킹.
!outputs/v2_phase3/
# 단, 피부톤 진단 그림은 재생성 가능(cvdlens_v2.skin_analysis, seed 고정)한 진단/데모용이라 제외.
# 수치 근거는 skin_analysis.json + skin_analysis_summary.md에 보존.
outputs/v2_phase3/skin_masks.png
outputs/v2_phase3/skin_severity_compare.png
# 케이스 스터디 그림은 재생성 가능(cvdlens_v2/step3_eval.py) — step3_report.md·json만 트래킹.
outputs/v2_phase3/step3_case_*.png

# 보정 품질 조사(#1~3) + 배포 일상 테스트: 리포트(.md)와 수치(.json)만 트래킹.
# 재생성 가능한 그림(PNG)과 다운로드 입력 이미지(JPG)는 제외 — 스크립트로 재현.
!outputs/artifact_analysis/
outputs/artifact_analysis/*.png
outputs/artifact_analysis/*.jpg
!outputs/daily_test/
outputs/daily_test/*.png
outputs/daily_test/*.jpg
outputs/daily_test/**/*.png
outputs/daily_test/**/*.jpg

# 논문 장별 초안은 git 밖에서 관리(로컬 유지). outline.md는 계속 추적.
paper/draft/

# 파이프라인 개선/진단 리포트(reports/): 리포트(.md)·수치(.json)만 트래킹,
# 재생성 가능한 그림(PNG)·이미지(JPG)는 제외 — diag_*.py / reeval_guided.py로 재현.
reports/**/*.png
reports/**/*.jpg
# Kaggle 노트북 출력 다운로드(재취득 가능: `kaggle kernels output shindonghwaa/cvdlens`) — git 밖 유지.
kaggle_output/
kaggle_output_v2/

# tritan 재학습 검증 세션 산출물(리포트·스캔 json·임시 onnx·v3 노트북) — 로컬 유지, 스크립트로 재생성.
reports/tritan_retrain_eval/
